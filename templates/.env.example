# ─────────────────────────────────────────────────────────────────────────────
# bdapps configuration
#
#   cp .env.example .env
#
# `.env` MUST be git-ignored. This file is committed and must only ever contain
# placeholders — never a real applicationId or password.
#
# In production do not ship a `.env` at all: use your host's secret manager.
#
# NEVER prefix any of these with NEXT_PUBLIC_ / VITE_ / REACT_APP_ — those are
# compiled into the browser bundle and become world-readable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials ─────────────────────────────────────────────────────────────
# The only two values every bdapps application needs. Both come from bdapps Pro
# provisioning. Treat the password like a payment key: it can send SMS to your
# whole subscriber base and debit money from your subscribers' mobile accounts.

BDAPPS_APP_ID=APP_XXXXXX
BDAPPS_PASSWORD=replace-me


# ── Service endpoints ───────────────────────────────────────────────────────
# Uncomment ONLY the endpoints for the APIs enabled on your application in
# bdapps Pro. An application can only call services it was provisioned for —
# calling anything else fails with E1309 no matter how correct the payload is.
#
# Leaving an endpoint unset is how your code knows the service is unavailable:
# the client should refuse to call it rather than fail at the platform.

# ── SMS ──
#BDAPPS_SMS_SEND_URL=https://developer.bdapps.com/sms/send

# ── USSD ──
#BDAPPS_USSD_SEND_URL=https://developer.bdapps.com/ussd/send

# ── Subscription ──
# One endpoint serves both register (action 1) and unregister (action 0).
#BDAPPS_SUBSCRIPTION_SEND_URL=https://developer.bdapps.com/subscription/send
#BDAPPS_SUBSCRIPTION_STATUS_URL=https://developer.bdapps.com/subscription/getStatus
#BDAPPS_SUBSCRIPTION_QUERY_BASE_URL=https://developer.bdapps.com/subscription/query-base

# ── OTP ── (registering web/app users from a plain mobile number)
#BDAPPS_OTP_REQUEST_URL=https://developer.bdapps.com/otp/request
#BDAPPS_OTP_VERIFY_URL=https://developer.bdapps.com/otp/verify

# ── Subscription Charging SDK ──
# A signed browser redirect to a bdapps-hosted consent page, NOT a library and
# NOT the credentials above. Ask support@bdapps.com to switch on "Enable Charging
# SDK" in General -> Advanced; the key and secret then appear in that section.
# The secret goes into a SHA-512 signature and never into the URL.
# See references/06-otp.md.
#BDAPPS_SDK_API_KEY=replace-me
#BDAPPS_SDK_API_SECRET=replace-me

# ── CaaS ── charging
#BDAPPS_CAAS_DEBIT_URL=https://developer.bdapps.com/caas/direct/debit
# Balance query also needs "Enable Query Balance Requests" in CaaS provisioning.
#BDAPPS_CAAS_GET_BALANCE_URL=https://developer.bdapps.com/caas/get/balance


# ─────────────────────────────────────────────────────────────────────────────
# bdappsAI — the bdapps AI gateway
#
# A SEPARATE product with a SEPARATE key. The credentials above will not
# authenticate a bdappsAI call, and the key below will not authenticate an SMS
# send. Get the key from https://developer.bdapps.com/bdappsai.
#
# It travels in an Authorization header — verbatim, no "Bearer" prefix — not in
# the JSON body like every telco API above. See references/14-bdapps-ai.md.
#
# This key spends a real prepaid token balance and is NOT IP-whitelisted, so a
# leak works from anywhere until you rotate it. Treat it exactly like the
# password above: backend only, never in a client bundle.
# ─────────────────────────────────────────────────────────────────────────────

#BDAPPSAI_API_KEY=replace-me

# Uncomment only the endpoints you use.
#BDAPPSAI_CHAT_COMPLETIONS_URL=https://developer.bdapps.com/bdappsai/api/v1/chat/completions
#BDAPPSAI_IMAGE_GENERATIONS_URL=https://developer.bdapps.com/bdappsai/api/v1/images/generations
